@startuml Activity_Donation_VNPay
title Quy trinh Quyen Gop Tien qua VNPay

start

partition "CITIZEN - Tao Thanh Toan (POST /donations/vnpay-create)" {
  :Citizen gui yeu cau quyen gop\\n{ amount, message } (Yeu cau dang nhap JWT);
  :Lay thong tin nguoi dung tu JWT (userId);
  :Lay IP client tu request headers;
  :Lay cau hinh VNPay tu .env\\n(TMN_CODE, HASH_SECRET, URL, RETURN_URL);
  :Tao orderId duy nhat\\nDONATE_YYMMDDHHMMSS_XXXX (random 4 chu so);
  :Luu Donation vao DB:\\n{ userId, orderId, amount, message, status: PENDING };
  :Xay dung vnp_Params va ky HMAC-SHA512;
  :Tra ve { paymentUrl };
  :Client chuyen huong nguoi dung den cong VNPAY;
}

partition "VNPAY - Xu Ly Thanh Toan" {
  :Nguoi dung thanh toan tai cong VNPay;
  fork
    :VNPay goi RETURN URL -> FE\\n(GET /donations/vnpay-return?...)\\nHien thi ket qua cho nguoi dung;
  fork again
    :VNPay goi IPN Webhook -> Server\\n(GET /donations/vnpay-ipn?...)\\nXu ly phia server - dam bao an toan;
  end fork
}

partition "Server - Xu Ly Return URL (GET /donations/vnpay-return)" {
  :Nhan toan bo query params tu VNPay;
  :Xac minh chu ky SecureHash (HMAC-SHA512);
  if (Chu ky khong hop le?) then (Co)
    :Tra ve 400\\n{ isSuccess: false, "Chu ky khong hop le" };
    stop
  else (Hop le)
  endif
  if (vnp_ResponseCode == '00'?) then (Co)
    :Tra ve 200\\n{ isSuccess: true, "Thanh toan thanh cong" };
  else (Khong)
    :Tra ve 400\\n{ isSuccess: false, "Giao dich that bai" };
  endif
  note right: Return URL chi de hien thi UI\\nkhong cap nhat DB (IPN moi cap nhat)
}

partition "Server - Xu Ly IPN Webhook (GET /donations/vnpay-ipn)" {
  :Nhan IPN tu VNPay;
  :Xac minh chu ky SecureHash;
  if (Chu ky sai?) then (Co)
    :Tra ve { RspCode: '97', 'Checksum failed' };
    stop
  else (OK)
  endif

  :Tim Donation theo orderId (vnp_TxnRef);
  if (Khong tim thay?) then (Co)
    :Tra ve { RspCode: '01', 'Order not found' };
    stop
  else (Tim thay)
  endif

  :Kiem tra so tien khop?\\n(vnp_Amount / 100 == donation.amount);
  if (So tien sai?) then (Co)
    :Tra ve { RspCode: '04', 'Invalid amount' };
    stop
  else (Khop)
  endif

  :Kiem tra trang thai da xu ly chua?\\n(donation.status != PENDING);
  if (Khong con PENDING?) then (Co)
    :Tra ve { RspCode: '02', 'Order already confirmed' };
    stop
  else (Chua xu ly)
  endif

  if (vnp_ResponseCode == '00'?) then (Co)
    :Cap nhat Donation:\\n{ status: SUCCESS, vnp_TransactionNo };
  else (Khong)
    :Cap nhat Donation:\\n{ status: FAILED };
  endif

  :Tra ve { RspCode: '00', 'Confirm Success' };
}

stop
@enduml
