@startuml
left to right direction
skinparam packageStyle rectangle

actor "Doi Cuu Ho (Rescue Team)" as team

rectangle "He Thong Rescue AID - RESCUE TEAM" {
  ' === AUTH & PROFILE ===
  usecase "Dang nhap" as UC1
  usecase "Xem ho so ca nhan" as UC2
  usecase "Cap nhat thong tin" as UC3
  usecase "Doi mat khau" as UC4

  ' === NHIEM VU CUU HO ===
