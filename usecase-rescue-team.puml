  usecase "Xem nhiem vu duoc phan cong (assigned-tasks)" as UC6
  usecase "Xem chi tiet yeu cau cuu ho" as UC7
  usecase "Cap nhat tien do cuu ho (IN_PROGRESS / COMPLETED)" as UC8
  usecase "Upload anh chung thuc khi hoan thanh" as UC9

  ' === QUAN LY DOI MINH ===
  usecase "Xem danh sach doi cuu ho" as UC10
  usecase "Xem chi tiet mot doi cu the" as UC11
  usecase "Cap nhat vi tri GPS" as UC12
  usecase "Cap nhat trang thai doi (AVAILABLE / OFFLINE)" as UC13

  ' === KHO HANG (CHI DOC) ===
  usecase "Xem kho hang (chi doc)" as UC14
}

team --> UC1
team --> UC2
team --> UC3
team --> UC4
team --> UC5
team --> UC6
team --> UC7
team --> UC8
team --> UC9
team --> UC10
team --> UC11
team --> UC12
team --> UC13
team --> UC14

