' COORDINATOR — Kết nối Use Cases
' ============================================================
COORDINATOR --> UC_LOGIN
COORDINATOR --> UC_VIEW_PROFILE
COORDINATOR --> UC_UPDATE_PROFILE
COORDINATOR --> UC_CHANGE_PASSWORD

COORDINATOR --> UC_ALL_REQUESTS
COORDINATOR --> UC_REQUEST_DETAIL
COORDINATOR --> UC_VERIFY_REQUEST
COORDINATOR --> UC_ASSIGN_TEAM
COORDINATOR --> UC_CANCEL_REQUEST
COORDINATOR --> UC_ASSIGNED_TASKS

COORDINATOR --> UC_ALL_TEAMS
COORDINATOR --> UC_AVAILABLE_TEAMS
COORDINATOR --> UC_TEAM_DETAIL
COORDINATOR --> UC_UPDATE_TEAM
COORDINATOR --> UC_ADD_VEHICLE
COORDINATOR --> UC_REMOVE_VEHICLE
COORDINATOR --> UC_UPDATE_TEAM_STATUS

COORDINATOR --> UC_ALL_VEHICLES
COORDINATOR --> UC_AVAILABLE_VEHICLES
COORDINATOR --> UC_VEHICLE_DETAIL
COORDINATOR --> UC_UPDATE_VEHICLE_STATUS

COORDINATOR --> UC_ALL_INVENTORY
COORDINATOR --> UC_INVENTORY_DETAIL
COORDINATOR --> UC_UPDATE_STOCK

COORDINATOR --> UC_DONATION_DETAIL

' ============================================================
' RESCUE_TEAM — Kết nối Use Cases
' ============================================================
RESCUE_TEAM --> UC_LOGIN
RESCUE_TEAM --> UC_VIEW_PROFILE
RESCUE_TEAM --> UC_UPDATE_PROFILE
RESCUE_TEAM --> UC_CHANGE_PASSWORD

RESCUE_TEAM --> UC_NEARBY_REQUESTS
RESCUE_TEAM --> UC_ASSIGNED_TASKS
RESCUE_TEAM --> UC_REQUEST_DETAIL
RESCUE_TEAM --> UC_UPDATE_STATUS

RESCUE_TEAM --> UC_ALL_TEAMS
RESCUE_TEAM --> UC_TEAM_DETAIL
RESCUE_TEAM --> UC_UPDATE_LOCATION
RESCUE_TEAM --> UC_UPDATE_TEAM_STATUS

RESCUE_TEAM --> UC_ALL_INVENTORY

' ============================================================
' MANAGER — Kết nối Use Cases
' ============================================================
MANAGER --> UC_LOGIN
MANAGER --> UC_VIEW_PROFILE
MANAGER --> UC_UPDATE_PROFILE
MANAGER --> UC_CHANGE_PASSWORD

MANAGER --> UC_CREATE_TEAM
MANAGER --> UC_ALL_TEAMS
MANAGER --> UC_AVAILABLE_TEAMS
MANAGER --> UC_TEAM_DETAIL
MANAGER --> UC_UPDATE_TEAM
MANAGER --> UC_DELETE_TEAM
MANAGER --> UC_ADD_MEMBER
MANAGER --> UC_REMOVE_MEMBER
MANAGER --> UC_ADD_VEHICLE
MANAGER --> UC_REMOVE_VEHICLE
MANAGER --> UC_UPDATE_TEAM_STATUS

MANAGER --> UC_ALL_VEHICLES
MANAGER --> UC_AVAILABLE_VEHICLES
MANAGER --> UC_VEHICLE_DETAIL
MANAGER --> UC_CREATE_VEHICLE
MANAGER --> UC_UPDATE_VEHICLE
MANAGER --> UC_UPDATE_VEHICLE_STATUS
MANAGER --> UC_DELETE_VEHICLE

MANAGER --> UC_ALL_INVENTORY
MANAGER --> UC_INVENTORY_DETAIL
