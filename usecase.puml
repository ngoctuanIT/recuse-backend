MANAGER --> UC_UPDATE_INVENTORY
MANAGER --> UC_UPDATE_STOCK
MANAGER --> UC_DELETE_INVENTORY

MANAGER --> UC_ALL_DONATIONS
MANAGER --> UC_DONATION_DETAIL

' ============================================================
' ADMIN — Kết nối Use Cases (Kế thừa tất cả + riêng của Admin)
' ============================================================
ADMIN --> UC_LOGIN
ADMIN --> UC_VIEW_PROFILE
ADMIN --> UC_UPDATE_PROFILE
ADMIN --> UC_CHANGE_PASSWORD

ADMIN --> UC_ALL_USERS
ADMIN --> UC_FIND_USER
ADMIN --> UC_CHANGE_ROLE
ADMIN --> UC_DEACTIVATE_USER

ADMIN --> UC_ALL_REQUESTS
ADMIN --> UC_REQUEST_DETAIL
ADMIN --> UC_VERIFY_REQUEST
ADMIN --> UC_ASSIGN_TEAM
ADMIN --> UC_CANCEL_REQUEST

ADMIN --> UC_CREATE_TEAM
ADMIN --> UC_ALL_TEAMS
ADMIN --> UC_TEAM_DETAIL
ADMIN --> UC_UPDATE_TEAM
ADMIN --> UC_DELETE_TEAM
ADMIN --> UC_ADD_MEMBER
ADMIN --> UC_REMOVE_MEMBER
ADMIN --> UC_ADD_VEHICLE
ADMIN --> UC_REMOVE_VEHICLE
ADMIN --> UC_UPDATE_TEAM_STATUS

ADMIN --> UC_ALL_VEHICLES
